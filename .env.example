# API Configuration
VITE_API_BASE_URL=https://beacon-admin.onrender.com

# Firebase Configuration (for app/mobile users only)
# Web admin uses PostgreSQL directly via backend
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Optional: Request timeout (milliseconds)
VITE_REQUEST_TIMEOUT=10000

# MapLibre + MapTiler (required for /map)
VITE_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY
VITE_MAPTILER_STYLE_ID=streets-v2
